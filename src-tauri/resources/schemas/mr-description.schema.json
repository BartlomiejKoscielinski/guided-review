{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MrDescription",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "what", "why", "how_to_test"],
  "properties": {
    "title": { "type": "string", "maxLength": 72 },
    "what": { "type": "string", "maxLength": 800 },
    "why": { "type": "string", "maxLength": 800 },
    "how_to_test": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 200 } }
  }
}
