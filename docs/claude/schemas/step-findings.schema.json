{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StepFindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "checklist", "files_read", "folds"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "kind", "title", "body", "file", "side", "line", "evidence", "suggested_comment"],
        "properties": {
          "severity": { "type": "string", "enum": ["fix", "q", "nit"] },
          "kind": { "type": "string", "pattern": "^[a-z0-9-]{3,48}$", "description": "Stable kebab-case category, e.g. 'unhandled-cancellation'. Used to recognise repeated dismissals." },
          "title": { "type": "string", "maxLength": 80 },
          "body": { "type": "string", "maxLength": 600 },
          "file": { "type": "string" },
          "side": { "type": "string", "enum": ["new", "old"] },
          "line": { "type": "integer", "minimum": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line", "note"],
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "note": { "type": "string", "maxLength": 120 }
              }
            }
          },
          "suggested_comment": { "type": "string", "maxLength": 600, "description": "Polite, specific comment the reviewer could post, phrased as a question or suggestion." }
        }
      }
    },
    "checklist": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 140 },
      "description": "Things only a human can judge (product intent, device behaviour)."
    },
    "files_read": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "why"],
        "properties": { "file": { "type": "string" }, "why": { "type": "string", "maxLength": 80 } }
      }
    },
    "folds": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "new_start", "new_end", "title", "reason"],
        "properties": {
          "file": { "type": "string" },
          "new_start": { "type": "integer", "minimum": 1 },
          "new_end": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "maxLength": 60, "description": "e.g. 'Fields and constructor: 3 new dependencies'" },
          "reason": { "type": "string", "maxLength": 120 }
        }
      }
    }
  }
}
